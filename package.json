{
  "name": "@luminescent/ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build:release": "pnpm run build && pnpm run release",
    "build": "pnpm nx run-many -t build --output-style=stream --parallel=3",
    "release": "tsx tools/release.ts",
    "start:docs": "pnpm run build && cd packages/ui-docs && pnpm run start",
    "prepare": "vp config",
    "deploy": "cd packages/ui-docs && pnpm run deploy"
  },
  "devDependencies": {
    "@nx/js": "^23.1.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "dotenv": "^17.4.2",
    "nx": "23.1.0",
    "tsx": "^4.23.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yargs": "^18.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24"
  }
}
