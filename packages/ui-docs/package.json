{
  "name": "@luminescent/ui-docs",
  "private": true,
  "description": "Luminescent UI Documentation",
  "homepage": "https://ui.luminescent.dev",
  "bugs": {
    "url": "https://github.com/LuminescentDev/ui/issues"
  },
  "author": {
    "name": "saboooor",
    "url": "https://saboor.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminescentDev/ui.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "qwik build",
    "build.client": "vp build",
    "build.preview": "vp build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "preview": "qwik build preview && vp preview",
    "serve": "wrangler dev",
    "start": "vp dev --mode ssr --host",
    "start.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --forcenode --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@luminescent/icons-qwik": "workspace:*",
    "@luminescent/ui": "workspace:*",
    "@luminescent/ui-qwik": "workspace:*",
    "@qwik.dev/core": "^2.0.0-rc.0",
    "@qwik.dev/router": "^2.0.0-rc.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "globals": "^17.13.0",
    "lucide-icons-qwik": "1.16.0-qwik-v2",
    "oxlint-plugin-qwik": "^0.0.9",
    "simple-icons-qwik": "16.19.0-qwik-v2",
    "tailwindcss": "^4.3.3",
    "ts-morph": "28",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "latest",
    "undici": "^8.11.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.146.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
