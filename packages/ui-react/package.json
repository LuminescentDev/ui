{
  "name": "@luminescent/ui-react",
  "version": "7.0.0",
  "private": false,
  "description": "Luminescent UI library - React",
  "homepage": "https://ui.luminescent.dev",
  "bugs": {
    "url": "https://github.com/LuminescentDev/ui/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "saboooor",
    "url": "https://saboor.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LuminescentDev/ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/ui-react.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vp dev",
    "dev": "vp dev",
    "build": "tsc -p tsconfig.json && vp build --mode lib && pnpm run build.types",
    "build.types": "tsc -p tsconfig.types.json --incremental false",
    "test": "vp test tests",
    "preview": "vp preview"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "globals": "^17.13.0",
    "oxlint-plugin-qwik": "^0.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@luminescent/ui": "workspace:*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
