{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Directly commit patch and minor updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Keep PRs for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
